# Gemini API Configuration (free tier - https://aistudio.google.com/apikey)
GEMINI_API_KEY=YOUR_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash-lite

# Supabase (banco central - Fase 2 do CLAUDE.md)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# n8n (VPS Hostinger) - motor operacional do CLAUDE.md
N8N_API_URL=https://YOUR_N8N_INSTANCE.example.com
N8N_API_KEY=YOUR_N8N_API_KEY_HERE

# Evolution API (VPS Hostinger) - canal WhatsApp
EVOLUTION_API_URL=https://YOUR_EVOLUTION_INSTANCE.example.com
EVOLUTION_API_KEY=YOUR_EVOLUTION_API_KEY_HERE
EVOLUTION_INSTANCE=YOUR_INSTANCE_NAME

# Server Configuration
PORT=3000
NODE_ENV=development

# Data Storage
DATA_DIR=./data

# Logging
LOG_LEVEL=info
